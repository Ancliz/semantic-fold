# Only lib/typescript.js is loaded at runtime (ts.createSourceFile plus the AST
# type guards). Keep it, the manifest, and the licence files; drop tsc, tsserver
# and the locale tables, which are ~10 MB of dead weight in the package.
node_modules/typescript/**
!node_modules/typescript/package.json
!node_modules/typescript/LICENSE.txt
!node_modules/typescript/ThirdPartyNoticeText.txt
!node_modules/typescript/lib/typescript.js
